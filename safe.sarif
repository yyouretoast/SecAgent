{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "SecAgent",
          "version": "0.1.0",
          "informationUri": "https://github.com/yyouretoast/SecAgent",
          "rules": [
            {
              "id": "POL-ASI01-001",
              "name": "Agent Goal Hijack Boundary Enforcement",
              "shortDescription": {
                "text": "Agent Goal Hijack Boundary Enforcement"
              },
              "fullDescription": {
                "text": "A suspicious instruction override must not steer an agent into an out-of-scope privileged tool call."
              },
              "help": {
                "text": "Keep tool selection constrained to the declared task context and reject instruction-override prompts before privileged dispatch."
              },
              "properties": {
                "owasp_category": "ASI01: Agent Goal Hijack",
                "severity": "CRITICAL"
              }
            },
            {
              "id": "POL-ASI01-002",
              "name": "Toxic Flow Indirect Prompt Injection Guard",
              "shortDescription": {
                "text": "Toxic Flow Indirect Prompt Injection Guard"
              },
              "fullDescription": {
                "text": "Untrusted data returned by read/net tools containing instruction overrides must not steer subsequent privileged or egress calls without HITL approval."
              },
              "help": {
                "text": "Treat external tool outputs as untrusted data and require explicit HITL approval before dispatching privileged sinks after tainted reads."
              },
              "properties": {
                "owasp_category": "ASI01: Agent Goal Hijack",
                "severity": "CRITICAL"
              }
            },
            {
              "id": "POL-ASI03-001",
              "name": "Predecessor HITL Gate Enforcement",
              "shortDescription": {
                "text": "Predecessor HITL Gate Enforcement"
              },
              "fullDescription": {
                "text": "Any financial or high-privilege payment/admin operation must be preceded by an authorized HITL approval gate."
              },
              "help": {
                "text": "Ensure the agent redirects high-risk operations (pay/admin) to the approval_gate before invoking execution tools."
              },
              "properties": {
                "owasp_category": "ASI03: Identity & Privilege Abuse",
                "severity": "CRITICAL"
              }
            },
            {
              "id": "POL-ASI03-002",
              "name": "Context Privilege Boundary Enforcement",
              "shortDescription": {
                "text": "Context Privilege Boundary Enforcement"
              },
              "fullDescription": {
                "text": "Read-only inquiry sessions are strictly forbidden from executing state-mutating or payment tools."
              },
              "help": {
                "text": "Constrain agent tool choice or add router guards preventing mutating tools during general inquiry tasks."
              },
              "properties": {
                "owasp_category": "ASI03: Identity & Privilege Abuse",
                "severity": "HIGH"
              }
            },
            {
              "id": "POL-ASI06-001",
              "name": "Need-to-Know Field Scope Allowlist",
              "shortDescription": {
                "text": "Need-to-Know Field Scope Allowlist"
              },
              "fullDescription": {
                "text": "Database queries during routine tasks must not over-fetch or leak sensitive PII or credential fields into working context."
              },
              "help": {
                "text": "Configure query_db tool schema and output projection to exclude sensitive profile fields (e.g., ssn, password_hash)."
              },
              "properties": {
                "owasp_category": "ASI06: Context Poisoning / Scope Abuse",
                "severity": "HIGH"
              }
            },
            {
              "id": "POL-ASI02-001",
              "name": "Tool Parameter SQL Injection Blocklist",
              "shortDescription": {
                "text": "Tool Parameter SQL Injection Blocklist"
              },
              "fullDescription": {
                "text": "Tool input parameters must not contain SQL injection keywords or tautologies."
              },
              "help": {
                "text": "Implement strict parameter type validation or parameterization before tool argument dispatch."
              },
              "properties": {
                "owasp_category": "ASI02: Tool Misuse & Exploitation",
                "severity": "CRITICAL"
              }
            },
            {
              "id": "POL-ASI08-001",
              "name": "Runaway Execution and Idempotency Circuit Breaker",
              "shortDescription": {
                "text": "Runaway Execution and Idempotency Circuit Breaker"
              },
              "fullDescription": {
                "text": "Prevent non-terminating retry loops, cascading failures, and excessive consecutive identical tool calls."
              },
              "help": {
                "text": "Add termination conditions and retry limits to the LangGraph ReAct planning loop."
              },
              "properties": {
                "owasp_category": "ASI08: Cascading Failures",
                "severity": "HIGH"
              }
            },
            {
              "id": "POL-ASI05-001",
              "name": "Arbitrary Code Execution & Shell Metacharacter Blocklist",
              "shortDescription": {
                "text": "Arbitrary Code Execution & Shell Metacharacter Blocklist"
              },
              "fullDescription": {
                "text": "Prevent arbitrary code execution or unescaped shell commands from being passed into tool parameters."
              },
              "help": {
                "text": "Disallow shell-executing tools or enforce strict parameter whitelisting without shell interpolation."
              },
              "properties": {
                "owasp_category": "ASI05: Unexpected Code Execution",
                "severity": "CRITICAL"
              }
            },
            {
              "id": "POL-ASI10-001",
              "name": "Unauthorized Network Egress Exfiltration Guard",
              "shortDescription": {
                "text": "Unauthorized Network Egress Exfiltration Guard"
              },
              "fullDescription": {
                "text": "Prevent unauthorized exfiltration of internal data to unapproved external endpoints."
              },
              "help": {
                "text": "Constrain network tool invocations to approved internal and partner domains."
              },
              "properties": {
                "owasp_category": "ASI10: Rogue Agent Egress Exfiltration",
                "severity": "CRITICAL"
              }
            }
          ]
        }
      },
      "results": []
    }
  ]
}